+    assert answer.evaluations[1].error == "ValueError"
+    assert answer.review.code_suggestions == []
+
+
+def test_disagreement_about_duplicate_identity_preserves_both_findings():
+    class Multiple:
+        def review(self, *args, **kwargs):
