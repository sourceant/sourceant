+
+def test_rejected_candidate_within_tolerance_does_not_degrade_coverage():
+    plan = ParallelReviewPlan(
+        (ReviewParticipant("reader", Reader(), object()),),
+        (EvaluationParticipant("challenge", Evaluator(EvaluationStatus.REJECTED)),),
